# ====================================================================
# YomuJi Environment Variables Template
# ====================================================================

# 1. Supabase PostgreSQL Configuration (Primary Auth & Dynamic Data)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Dictionary Backend Feature Flag
# Options:
#   - supabase (Default active backend for 100% production safety)
#   - turso    (Switches dictionary queries to Turso libSQL)
#   - compare  (Dev mode side-by-side verification: queries both, logs metrics, returns Supabase)
DICTIONARY_BACKEND=supabase

# 3. Turso libSQL Cloud Database Configuration (Server-Only)
# CRITICAL: Never expose TURSO_AUTH_TOKEN in NEXT_PUBLIC_ or client bundles!
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# 4. AI explanation providers (Server-Only)
# CRITICAL: Never prefix these keys with NEXT_PUBLIC_ or commit real values.
# Store local values in the ignored .env.local file or deployment secrets.
TOKENROUTER_API_KEY=your-tokenrouter-api-key
GEMINI_API_KEY=your-gemini-api-key
